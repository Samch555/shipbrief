{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShipBrief archive index",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "latest", "days"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "updatedAt": { "type": "string" },
    "latest": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "path", "itemCount"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "path": { "type": "string" },
          "itemCount": { "type": "integer", "minimum": 0 },
          "headline": { "type": "string" },
          "summaryMode": { "type": "string" }
        }
      }
    }
  }
}
